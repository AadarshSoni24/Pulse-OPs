{
  "info": {
    "_postman_id": "pulseops-collection-v1",
    "name": "PulseOps Monitoring Platform API",
    "description": "Complete REST API Collection for PulseOps Uptime, Latency, and SSL Monitoring System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "workspaceId",
      "value": "",
      "type": "string"
    },
    {
      "key": "monitorId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET System Health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:4000/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["health"]
            }
          }
        },
        {
          "name": "GET System Telemetry Metrics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/metrics",
              "host": ["{{baseUrl}}"],
              "path": ["metrics"]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@pulseops.com\",\n  \"password\": \"Password123!\",\n  \"name\": \"Demo User\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "POST Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@pulseops.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "GET Current User (/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Monitors",
      "item": [
        {
          "name": "POST Create Monitor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"GitHub API Status\",\n  \"url\": \"https://www.githubstatus.com/api/v2/status.json\",\n  \"method\": \"GET\",\n  \"interval\": 30,\n  \"timeout\": 5000,\n  \"expectedStatus\": 200\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceId}}/monitors",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceId}}", "monitors"]
            }
          }
        },
        {
          "name": "GET List Workspace Monitors",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceId}}/monitors",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceId}}", "monitors"]
            }
          }
        },
        {
          "name": "GET Monitor Analytics Math",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceId}}/monitors/{{monitorId}}/analytics",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceId}}", "monitors", "{{monitorId}}", "analytics"]
            }
          }
        }
      ]
    },
    {
      "name": "Status Page",
      "item": [
        {
          "name": "GET Public Status Page",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/status/acme-corp",
              "host": ["{{baseUrl}}"],
              "path": ["status", "acme-corp"]
            }
          }
        }
      ]
    }
  ]
}
