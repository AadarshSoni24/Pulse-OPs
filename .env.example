PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pulseops?schema=public"
REDIS_URL="redis://127.0.0.1:6379"

JWT_ACCESS_SECRET="super-secret-pulseops-access-key-change-in-prod"
JWT_REFRESH_SECRET="super-secret-pulseops-refresh-key-change-in-prod"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Email Config (Nodemailer / Mock)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="PulseOps System Alerts <alerts@pulseops.com>"

# Security & CORS
CORS_ORIGIN="*"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
